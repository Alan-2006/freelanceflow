# FreelanceFlow Environment Configuration

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-freelanceflow-super-secret-key-change-in-prod-2026!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base URL for public links & magic links
SITE_URL=http://127.0.0.1:8000

# Database (Leave DATABASE_URL blank to use SQLite in dev, or specify Postgres url)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/freelanceflow
DATABASE_URL=

# Celery & Redis
REDIS_URL=redis://localhost:6379/0
USE_CELERY=False

# Email Backend (console for dev, smtp for prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="FreelanceFlow <no-reply@freelanceflow.local>"

# Payment Gateways (Razorpay Test Keys)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=rzp_test_sample_key_secret
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_key

# Google OAuth 2.0 / Google Identity Services
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback/
